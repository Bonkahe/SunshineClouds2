
#define PI 3.141592


#define ATMOSPHERE_SURFACE_SUN_BLOCK_WIDE 0.766
#define ATMOSPHERE_SURFACE_SUN_BLOCK_TIGHT 0.990

// How far two MSAA samples of one pixel may differ in view distance before they
// each need their own aerial perspective solve. The scattering integral varies on
// the scale of the atmosphere's 8km scale height, so 0.5% of the view distance is
// far below anything that survives the MSAA resolve.
#define AERIAL_REUSE_TOLERANCE 0.005
#define AERIAL_REUSE_SHADOW_TOLERANCE 0.02

// Depth-aware upsampling of the low-res cloud buffer. A tap's weight falls off
// with the relative difference between the geometry distance it was marched
// against and this pixel's own: at 10% apart a tap keeps a third of its weight.
#define UPSAMPLE_DEPTH_SHARPNESS 16.0
// Caps the relative difference so the falloff never underflows to zero; with all
// four taps on other surfaces, the closest match still wins.
#define UPSAMPLE_MAX_RELATIVE 4.0
// Lets a well-matched tap take over even where its bilinear weight is ~0.
#define UPSAMPLE_BILINEAR_FLOOR 0.001

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D input_data_image;
layout(binding = 1) uniform sampler2D input_color_image;
layout(rgba32f, binding = 2) uniform image2D reflections_sample;
layout(binding = 3) uniform Sampler2DMSAA input_screen_image;
layout(rgba16f, binding = 4) restrict uniform Image2DMSAA output_screen_image;
layout(binding = 5) uniform Sampler2DMSAA depth_image;

layout(binding = 6) uniform uniformBuffer {
	GenericData data;
} genericData;

layout(binding = 7) uniform LightsBuffer {
	DirectionalLight directionalLights[4];
	PointLight pointLights[128];
	PointEffector pointEffectors[64];
};

layout(binding = 8, std140) uniform SceneDataBlock {
	CameraData data;
	CameraData prev_data;
} scene_data_block;

float remap(float value, float min1, float max1, float min2, float max2) {
  return min2 + (value - min1) * (max2 - min2) / (max1 - min1);
}

float surfaceMatch(float tapGeometry, float pixelGeometry){
	float relative = abs(tapGeometry - pixelGeometry) / max(min(tapGeometry, pixelGeometry), 1.0);
	return exp2(-min(relative, UPSAMPLE_MAX_RELATIVE) * UPSAMPLE_DEPTH_SHARPNESS);
}

float tapOcclusion(vec4 tapData, float linear_depth, float minstep){
	if (linear_depth >= tapData.a){
		return 0.0;
	}
	float cloudFront = min(tapData.r, tapData.b);
	float cloudThin = cloudFront + minstep;
	float cloudBack = clamp(2.0 * tapData.b - cloudFront, cloudThin, max(tapData.g, cloudThin));

	float occludedFrom = clamp(linear_depth, cloudFront, cloudBack);
	return clamp((cloudBack - occludedFrom) / (cloudBack - cloudFront), 0.0, 1.0);
}

void main() {
    ivec2 uv = ivec2(gl_GlobalInvocationID.xy);
    ivec2 lowres_size = ivec2(genericData.data.raster_size);

    int resolutionScale = int(genericData.data.resolutionscale);
    ivec2 size = lowres_size * resolutionScale;

	vec2 depthUV = (vec2(uv) + 0.5) / vec2(size);
	depthUV = clamp(depthUV, vec2(0.0), vec2(1.0));

	vec2 accumUV = depthUV;

	vec2 lowres_sizefloat = vec2(lowres_size);

	float minstep = genericData.data.min_step_distance;
	float maxstep = genericData.data.max_step_distance;
	float maxTheoreticalStep = genericData.data.max_step_count * maxstep;

	vec2 dataTexel = accumUV * lowres_sizefloat - 0.5;
	vec2 dataBase = floor(dataTexel);
	vec2 dataFrac = dataTexel - dataBase;

	ivec2 dataMaxUV = lowres_size - ivec2(1);
	ivec2 tapUV[4] = ivec2[4](
		clamp(ivec2(dataBase),               ivec2(0), dataMaxUV),
		clamp(ivec2(dataBase) + ivec2(1, 0), ivec2(0), dataMaxUV),
		clamp(ivec2(dataBase) + ivec2(0, 1), ivec2(0), dataMaxUV),
		clamp(ivec2(dataBase) + ivec2(1, 1), ivec2(0), dataMaxUV));
	float tapBilinear[4] = float[4](
		(1.0 - dataFrac.x) * (1.0 - dataFrac.y),
		dataFrac.x * (1.0 - dataFrac.y),
		(1.0 - dataFrac.x) * dataFrac.y,
		dataFrac.x * dataFrac.y);

	vec4 tapColor[4];
	vec4 tapData[4];
	for (int t = 0; t < 4; t++){
		tapColor[t] = texelFetch(input_color_image, tapUV[t], 0);
		tapData[t] = texelFetch(input_data_image, tapUV[t], 0);
	}

	vec2 clipUV = vec2(depthUV.x, depthUV.y);
	vec2 ndc = clipUV * 2.0 - 1.0;
	vec4 clipPos = vec4(ndc, 0.0, 1.0);
	vec4 viewPos = scene_data_block.data.inv_projection_matrix * clipPos;
	viewPos.xyz /= viewPos.w;

	vec3 rd_world = normalize(viewPos.xyz);
	rd_world = mat3(scene_data_block.data.main_cam_inv_view_matrix) * rd_world;

	vec3 raydirection = normalize(rd_world);
	vec3 rayOrigin = scene_data_block.data.main_cam_inv_view_matrix[3].xyz;

	vec4 averageColor = vec4(0.0);
	float reflectionDistance = 0.0;

	vec3 ambientfogdistancecolor = genericData.data.ambientfogdistancecolor.rgb * genericData.data.ambientfogdistancecolor.a;
	float atmosphericDensity = genericData.data.atmospheric_density;
	int atmoLightCount = min(int(genericData.data.directionalLightsCount), 4);

	vec3 atmoSunDirections[4];
	vec3 atmoSunColors[4];
	float atmoSunBlock[4] = float[4](0.0, 0.0, 0.0, 0.0);
	for (int i = 0; i < atmoLightCount; i++){
		atmoSunDirections[i] = directionalLights[i].direction.xyz;
		atmoSunColors[i] = directionalLights[i].color.rgb * directionalLights[i].color.a * ATMOSPHERE_SUN_INTENSITY;
		atmoSunBlock[i] = smoothstep(ATMOSPHERE_SURFACE_SUN_BLOCK_WIDE, ATMOSPHERE_SURFACE_SUN_BLOCK_TIGHT,
			dot(raydirection, atmoSunDirections[i]));
	}


	AerialPerspective cachedAerial;
	float cachedDepth = -1.0;
	float cachedSurface = -1.0;
	float cachedShadowProxy = -1.0;

	for (int sampleIdx = 0; sampleIdx < textureSamplesMSAA(depth_image); ++sampleIdx) {
		float depth = texelFetchMSAA(depth_image, uv, sampleIdx).r;
		vec4 view = scene_data_block.data.inv_projection_matrix * vec4(depthUV*2.0-1.0,depth,1.0);
		view.xyz /= view.w;
		float linear_depth = length(view);
		if (depth <= 0.0){
			linear_depth = 1e9;
		}
		bool debugCollisions = false;

		float pixelGeometry = min(linear_depth, min(maxTheoreticalStep, DATA_DISTANCE_MAX));

		vec4 cloudSum = vec4(0.0);
		float rawAlphaSum = 0.0;
		float lerpSum = 0.0;
		float traveledSum = 0.0;
		float weightSum = 0.0;
		for (int t = 0; t < 4; t++){

			float match = surfaceMatch(tapData[t].a, pixelGeometry);
			float tapLerp = tapOcclusion(tapData[t], linear_depth, minstep) * (1.0 - match);
			float weight = (tapBilinear[t] + UPSAMPLE_BILINEAR_FLOOR) * match;
			cloudSum += tapColor[t] * (1.0 - tapLerp) * weight;
			rawAlphaSum += clamp(tapColor[t].a, 0.0, 1.0) * weight;
			lerpSum += tapLerp * weight;
			traveledSum += tapData[t].g * weight;
			weightSum += weight;
		}
		float invWeight = 1.0 / weightSum;
		vec3 cloudPremultiplied = cloudSum.rgb * invWeight;
		float density = clamp(cloudSum.a * invWeight, 0.0, 1.0);
		float lerp = lerpSum * invWeight;
		reflectionDistance = traveledSum * invWeight;

		float cloudShadowProxy = 1.0 - rawAlphaSum * invWeight;
		float skyFade = smoothstep(maxTheoreticalStep - max(maxstep, 1.0), maxTheoreticalStep, linear_depth);
		float groundLinearFade = mix(skyFade, 1.0, genericData.data.fogEffectGround);

		vec4 color = texelFetchMSAA(input_screen_image, uv, sampleIdx);

		float surfacePresent = depth > 0.0 ? 1.0 : 0.0;

		if (cachedDepth < 0.0 || surfacePresent != cachedSurface
			|| abs(linear_depth - cachedDepth) > cachedDepth * AERIAL_REUSE_TOLERANCE
			|| abs(cloudShadowProxy - cachedShadowProxy) > AERIAL_REUSE_SHADOW_TOLERANCE){

			float atmoSunShadows[4] = float[4](1.0, 1.0, 1.0, 1.0);
			for (int i = 0; i < atmoLightCount; i++){
				atmoSunShadows[i] = min(cloudShadowProxy, 1.0 - surfacePresent * atmoSunBlock[i]);
			}

			cachedAerial = computeAerialPerspective(
				rayOrigin, raydirection, linear_depth, atmosphericDensity,
				atmoLightCount, atmoSunDirections, atmoSunColors, atmoSunShadows, ambientfogdistancecolor);
			cachedDepth = linear_depth;
			cachedSurface = surfacePresent;
			cachedShadowProxy = cloudShadowProxy;
		}

		AerialPerspective backgroundAerial = cachedAerial;

		vec3 fogTransmittance = mix(vec3(1.0), backgroundAerial.transmittance, groundLinearFade);
		vec3 fogInscatter = backgroundAerial.inscatter * groundLinearFade;

		vec3 physicalFogColor = color.rgb * fogTransmittance + fogInscatter;
		float fogweight = clamp(aerialPerspectiveOpacity(backgroundAerial) * groundLinearFade, 0.0, 1.0);

		color.rgb = mix(physicalFogColor, mix(color.rgb, ambientfogdistancecolor, fogweight),  genericData.data.atmosphere_simple_blend);

		color.rgb = color.rgb * (1.0 - density) + cloudPremultiplied;
		// color.rgb = vec3(clamp(traveledDistance / maxTheoreticalStep, 0.0, 1.0));

		if (debugCollisions){
			color.rgb = vec3(lerp);
		}

		imageStoreMSAA(output_screen_image, uv, sampleIdx, color);

		averageColor.rgb += color.rgb;
	}

	averageColor /= textureSamplesMSAA(depth_image);

	if (resolutionScale != 1){
		imageStore(reflections_sample, ivec2(accumUV * vec2(lowres_size)), vec4(averageColor.rgb, reflectionDistance));
	}
	else{
		imageStore(reflections_sample, uv, vec4(averageColor.rgb, reflectionDistance));
	}
}