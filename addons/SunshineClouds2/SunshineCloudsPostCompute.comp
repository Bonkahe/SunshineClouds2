void main() {
    ivec2 uv = ivec2(gl_GlobalInvocationID.xy);
    ivec2 lowres_size = ivec2(genericData.data.raster_size);

    int resolutionScale = int(genericData.data.resolutionscale);
    ivec2 size = lowres_size * resolutionScale;

	vec2 depthUV = (vec2(uv) + 0.5) / vec2(size);
	depthUV = clamp(depthUV, vec2(0.0), vec2(1.0));

	vec2 accumUV = depthUV;

	vec2 lowres_sizefloat = vec2(lowres_size);
	vec4 currentAccumilation = vec4(0.0);
	vec4 currentColorData = vec4(0.0);

	currentAccumilation = texture(input_color_image, accumUV);

	vec2 dataTexel = accumUV * lowres_sizefloat - 0.5;
	vec2 dataBase = floor(dataTexel);
	vec2 dataFrac = dataTexel - dataBase;

	ivec2 dataMaxUV = lowres_size - ivec2(1);
	ivec2 dt00 = clamp(ivec2(dataBase),               ivec2(0), dataMaxUV);
	ivec2 dt10 = clamp(ivec2(dataBase) + ivec2(1, 0), ivec2(0), dataMaxUV);
	ivec2 dt01 = clamp(ivec2(dataBase) + ivec2(0, 1), ivec2(0), dataMaxUV);
	ivec2 dt11 = clamp(ivec2(dataBase) + ivec2(1, 1), ivec2(0), dataMaxUV);

	float dw00 = (1.0 - dataFrac.x) * (1.0 - dataFrac.y) * clamp(texelFetch(input_color_image, dt00, 0).a, 0.0, 1.0);
	float dw10 = dataFrac.x * (1.0 - dataFrac.y) * clamp(texelFetch(input_color_image, dt10, 0).a, 0.0, 1.0);
	float dw01 = (1.0 - dataFrac.x) * dataFrac.y * clamp(texelFetch(input_color_image, dt01, 0).a, 0.0, 1.0);
	float dw11 = dataFrac.x * dataFrac.y * clamp(texelFetch(input_color_image, dt11, 0).a, 0.0, 1.0);
	float dataWeight = dw00 + dw10 + dw01 + dw11;

	if (dataWeight > 1e-5){
		currentColorData = (texelFetch(input_data_image, dt00, 0) * dw00
		                  + texelFetch(input_data_image, dt10, 0) * dw10
		                  + texelFetch(input_data_image, dt01, 0) * dw01
		                  + texelFetch(input_data_image, dt11, 0) * dw11) / dataWeight;
	}
	else{
		currentColorData = texture(input_data_image, accumUV);
	}

	float initialdistanceSample = currentColorData.r;
	float traveledDistance = currentColorData.g;
	float visibleDistance = currentColorData.b;
	float marchedAgainst = currentColorData.a;

	float minstep = genericData.data.min_step_distance;
	float maxstep = genericData.data.max_step_distance;

	float blurPower = genericData.data.blurPower;
	float maxTheoreticalStep = genericData.data.max_step_count * maxstep;

	float blurDistanceNormaliser = min(maxTheoreticalStep, DATA_DISTANCE_MAX);
	blurPower = mix(blurPower, 0.0, clamp(currentColorData.b / blurDistanceNormaliser, 0.0, 1.0));

	if (blurPower > 0.0){
		float blurHorizontal = blurPower / float(size.x);
		float blurVertical = blurPower / float(size.y);
		float blurQuality = genericData.data.blurQuality;
		currentAccumilation = radialBlurColor(currentAccumilation, input_color_image, input_data_image, accumUV, lowres_sizefloat, blurQuality * 4.0, blurVertical, blurHorizontal, blurQuality);
	}

	vec2 clipUV = vec2(depthUV.x, depthUV.y);
	vec2 ndc = clipUV * 2.0 - 1.0;
	vec4 clipPos = vec4(ndc, 0.0, 1.0);
	vec4 viewPos = scene_data_block.data.inv_projection_matrix * clipPos;
	viewPos.xyz /= viewPos.w;

	vec3 rd_world = normalize(viewPos.xyz);
	rd_world = mat3(scene_data_block.data.main_cam_inv_view_matrix) * rd_world;

	vec3 raydirection = normalize(rd_world);
	vec3 rayOrigin = scene_data_block.data.main_cam_inv_view_matrix[3].xyz;

	vec4 averageColor = vec4(0.0);

	for (int sampleIdx = 0; sampleIdx < textureSamplesMSAA(depth_image); ++sampleIdx) {
		float depth = texelFetchMSAA(depth_image, uv, sampleIdx).r;
		vec4 view = scene_data_block.data.inv_projection_matrix * vec4(depthUV*2.0-1.0,depth,1.0);
		view.xyz /= view.w;
		float linear_depth = length(view);
		if (depth <= 0.0){
			linear_depth = 1e9;
		}
		float density = clamp(currentAccumilation.a, 0.0, 1.0);

		float lerp = 0.0;
		bool debugCollisions = false;

		// if (linear_depth - max(max(traveledDistance, initialdistanceSample), finalDensityDistance) < maxstep){
		// 	float firsttravelblend = mix(1.0 - clamp((traveledDistance - finalDensityDistance) / minstep, 0.0, 1.0), 1.0, clamp(finalDensityDistance / maxstep, 0.0, 1.0));
		// 	lerp = (clamp((traveledDistance - linear_depth) / (traveledDistance - finalDensityDistance), 0.0, 1.0)) * firsttravelblend;
		// }

		float cloudFront = min(initialdistanceSample, visibleDistance);
		float cloudThin = cloudFront + minstep;
		float cloudBack = clamp(2.0 * visibleDistance - cloudFront, cloudThin, max(traveledDistance, cloudThin));

		if (linear_depth < marchedAgainst){
			float occludedFrom = clamp(linear_depth, cloudFront, cloudBack);
			float occludedTo = clamp(marchedAgainst, cloudFront, cloudBack);

			lerp = clamp((occludedTo - occludedFrom) / (cloudBack - cloudFront), 0.0, 1.0);
		}

		density = mix(density, 0.0, lerp);
		float skyFade = smoothstep(maxTheoreticalStep - max(maxstep, 1.0), maxTheoreticalStep, linear_depth);
		float groundLinearFade = mix(skyFade, 1.0, genericData.data.fogEffectGround);

		vec4 color = texelFetchMSAA(input_screen_image, uv, sampleIdx);

		vec3 ambientfogdistancecolor = genericData.data.ambientfogdistancecolor.rgb * genericData.data.ambientfogdistancecolor.a;
		float atmosphericDensity = genericData.data.atmospheric_density;
		float directionalLightCount = genericData.data.directionalLightsCount;

		vec3 atmoSunDirections[4];
		vec3 atmoSunColors[4];
		float atmoSunShadows[4] = float[4](1.0, 1.0, 1.0, 1.0);
		int atmoLightCount = min(int(directionalLightCount), 4);
		for (int i = 0; i < atmoLightCount; i++){
			atmoSunDirections[i] = directionalLights[i].direction.xyz;
			atmoSunColors[i] = directionalLights[i].color.rgb * directionalLights[i].color.a * ATMOSPHERE_SUN_INTENSITY;
		}

		AerialPerspective backgroundAerial = computeAerialPerspective(
			rayOrigin, raydirection, linear_depth, atmosphericDensity,
			atmoLightCount, atmoSunDirections, atmoSunColors, atmoSunShadows, ambientfogdistancecolor);

		vec3 fogTransmittance = mix(vec3(1.0), backgroundAerial.transmittance, groundLinearFade);
		vec3 fogInscatter = backgroundAerial.inscatter * groundLinearFade;

		vec3 physicalFogColor = color.rgb * fogTransmittance + fogInscatter;
		float fogweight = clamp(aerialPerspectiveOpacity(backgroundAerial) * groundLinearFade, 0.0, 1.0);

		color.rgb = mix(physicalFogColor, mix(color.rgb, ambientfogdistancecolor, fogweight),  genericData.data.atmosphere_simple_blend);

		color.rgb = mix(color.rgb, currentAccumilation.rgb, density);
		// color.rgb = vec3(clamp(traveledDistance / maxTheoreticalStep, 0.0, 1.0));

		if (debugCollisions){
			color.rgb = vec3(lerp);
		}

		imageStoreMSAA(output_screen_image, uv, sampleIdx, color);

		averageColor.rgb += color.rgb;
	}

	averageColor /= textureSamplesMSAA(depth_image);

	if (resolutionScale != 1){
		imageStore(reflections_sample, ivec2(accumUV * vec2(lowres_size)), vec4(averageColor.rgb, traveledDistance));
	}
	else{
		imageStore(reflections_sample, uv, vec4(averageColor.rgb, traveledDistance));
	}
}